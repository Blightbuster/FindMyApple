# Copy to .env (never committed) to run the tests against your own data.
# Without .env the tests use made-up values. Environment variables override this file.

# One of your Find My tags, as the spike or Home Assistant saw it.
FMA_TEST_TAG_NAME=Keys
FMA_TEST_TAG_MODEL=PAD Tag
FMA_TEST_TAG_LATITUDE=52.52
FMA_TEST_TAG_LONGITUDE=13.405
FMA_TEST_TAG_ACCURACY=72
